{
  "name": "dsh-plugin-template",
  "version": "0.1.0",
  "description": "{{DESCRIPTION}}",
  "license": "Apache-2.0",
  "author": "{{AUTHOR}}",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/{{OWNER}}/dsh-plugin-template.git"
  },
  "homepage": "https://github.com/{{OWNER}}/dsh-plugin-template#readme",
  "bugs": {
    "url": "https://github.com/{{OWNER}}/dsh-plugin-template/issues"
  },
  "template": {
    "name": "dsh-plugin-template",
    "author": "exoticknight",
    "url": "https://github.com/exoticknight/dsh-plugin-template"
  },
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:package": "node scripts/check-package.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "pnpm typecheck && pnpm build && pnpm test && pnpm check:package",
    "hooks:install": "simple-git-hooks",
    "dev": "node scripts/dev.mjs start",
    "dev:install": "node scripts/dev.mjs install",
    "dev:dsh": "node scripts/dev.mjs run",
    "dev:clean": "node scripts/dev.mjs clean",
    "smoke": "node scripts/smoke.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  }
}
